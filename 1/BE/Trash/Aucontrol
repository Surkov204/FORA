            return Ok(new
            {
                message = "Đã gửi lại email xác thực. Vui lòng kiểm tra inbox/spam.",
                dev = new { verifyUrl }
            });

        }

        private static string NormalizeOrigin(string? originOrUrl)
        {
            if (string.IsNullOrWhiteSpace(originOrUrl))
                return string.Empty;

            var raw = originOrUrl.Trim();
            if (Uri.TryCreate(raw, UriKind.Absolute, out var absolute))
                return absolute.GetLeftPart(UriPartial.Authority).TrimEnd('/');

            return raw.TrimEnd('/');
        }

        private string[] GetConfiguredGoogleOrigins()
        {
            var explicitOrigins = _configuration.GetSection("GoogleAuth:AllowedOrigins").Get<string[]>() ?? Array.Empty<string>();
            var frontendOrigin = NormalizeOrigin(_configuration["App:FrontendBaseUrl"]);

            return explicitOrigins
                .Select(NormalizeOrigin)
                .Concat(new[] { frontendOrigin })
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();
        }

        private static bool IsOriginAllowed(string requestOrigin, IEnumerable<string> configuredOrigins)
        {
            if (string.IsNullOrWhiteSpace(requestOrigin))
                return false;

            return configuredOrigins.Any(origin => string.Equals(origin, requestOrigin, StringComparison.OrdinalIgnoreCase));
        }

        private string GenerateJwtToken(User user)
        {
            var claims = new[]
            {
                new Claim(ClaimTypes.NameIdentifier, user.Id.ToString()),
                new Claim(ClaimTypes.Email, user.Email),
                new Claim(ClaimTypes.Role, "USER")
            };

            var key = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(_configuration["Jwt:Key"]));
            var creds = new SigningCredentials(key, SecurityAlgorithms.HmacSha256);

            var token = new JwtSecurityToken(
                issuer: _configuration["Jwt:Issuer"],
                audience: _configuration["Jwt:Audience"],
                claims: claims,
                expires: DateTime.UtcNow.AddDays(double.Parse(_configuration["Jwt:ExpireDays"])),
                signingCredentials: creds
            );

            return new JwtSecurityTokenHandler().WriteToken(token);
        }


[HttpPost("reset-password")]
public async Task<IActionResult> ResetPassword([FromBody] ResetPasswordDto dto)
{
    var email = dto.Email.Trim().ToLower();
    var user = await _db.Users.FirstOrDefaultAsync(u => u.Email.ToLower() == email);

    if (user == null) return BadRequest(new { message = "Email không tồn tại" });

    if (user.PasswordResetExpiresAt == null || user.PasswordResetExpiresAt < DateTime.UtcNow)
        return BadRequest(new { message = "Token đã hết hạn", code = "TOKEN_EXPIRED" });

    var tokenHash = Sha256Base64Url(dto.Token);
    if (user.PasswordResetTokenHash == null || user.PasswordResetTokenHash != tokenHash)
        return BadRequest(new { message = "Token không hợp lệ", code = "INVALID_TOKEN" });

    // ✅ update password
    user.PasswordHash = BCrypt.Net.BCrypt.HashPassword(dto.NewPassword);


    // ✅ clear token
    user.PasswordResetTokenHash = null;
    user.PasswordResetExpiresAt = null;

    await _db.SaveChangesAsync();

    return Ok(new { message = "Đổi mật khẩu thành công ✅" });
}



        [HttpPost("forgot-password")]
public async Task<IActionResult> ForgotPassword([FromBody] ForgotPasswordDto dto)
{
    var email = dto.Email.Trim().ToLower();
    var user = await _db.Users.FirstOrDefaultAsync(u => u.Email.ToLower() == email);

    // ✅ luôn trả OK để tránh leak email có tồn tại hay không
    if (user == null)
        return Ok(new { message = "Nếu email tồn tại, hệ thống đã gửi link đặt lại mật khẩu." });

