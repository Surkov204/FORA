        [HttpPost("google")]
        public async Task<IActionResult> GoogleLogin([FromBody] GoogleLoginDto dto)
        {
            Console.WriteLine($"[GOOGLE_DEBUG] POST google idTokenLength={dto?.IdToken?.Length ?? 0} origin={Request.Headers.Origin.ToString()}");

            if (string.IsNullOrWhiteSpace(dto.IdToken))
                return BadRequest(new { message = "Thieu idToken" });

            var configuredClientId = _configuration["GoogleAuth:ClientId"];
            if (string.IsNullOrWhiteSpace(configuredClientId))
                return StatusCode(StatusCodes.Status500InternalServerError, new
                {
                    message = "Google login chua duoc cau hinh tren server"
                });

            GoogleJsonWebSignature.Payload payload;

            try
            {
                payload = await GoogleJsonWebSignature.ValidateAsync(dto.IdToken, new GoogleJsonWebSignature.ValidationSettings
                {
                    Audience = new[] { configuredClientId }
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[GOOGLE_DEBUG] Google token validate failed: {ex.Message}");
                return Unauthorized(new { message = "Google token khong hop le", detail = ex.Message });
            }

            var email = payload.Email?.Trim().ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(email))
                return BadRequest(new { message = "Khong lay duoc email tu Google token" });

            var user = await _db.Users
                .Include(u => u.Profile)
                .FirstOrDefaultAsync(u => u.Email == email);
            var autoRegistered = false;

            if (user == null)
            {
                autoRegistered = true;
                user = new User
                {
                    Email = email,
                    PasswordHash = BCrypt.Net.BCrypt.HashPassword(Guid.NewGuid().ToString("N")),
                    CreatedAt = DateTime.UtcNow,
                    LastLoginAt = DateTime.UtcNow,
                    IsEmailVerified = true,
                    EmailVerificationTokenHash = null,
                    EmailVerificationExpiresAt = null
                };

                _db.Users.Add(user);
                await _db.SaveChangesAsync();

                var fallbackDisplayName = email.Split('@')[0];
                var profile = new UserProfile
                {
                    UserId = user.Id,
                    DisplayName = string.IsNullOrWhiteSpace(payload.Name) ? fallbackDisplayName : payload.Name,
                    AvatarUrl = string.IsNullOrWhiteSpace(payload.Picture)
                        ? "https://i.pinimg.com/736x/01/6c/6f/016c6fd3571087621dc810ecfad542a9.jpg"
                        : payload.Picture,
                    Bio = "",
                    CreatedAt = DateTime.UtcNow
                };

                _db.UserProfiles.Add(profile);
                await _db.SaveChangesAsync();

                user.Profile = profile;
            }
            else
            {
                user.LastLoginAt = DateTime.UtcNow;

                if (!user.IsEmailVerified)
                {
                    user.IsEmailVerified = true;
                    user.EmailVerificationTokenHash = null;
                    user.EmailVerificationExpiresAt = null;
                }

                if (user.Profile == null)
                {
                    var fallbackDisplayName = email.Split('@')[0];
                    var profile = new UserProfile
                    {
                        UserId = user.Id,
                        DisplayName = string.IsNullOrWhiteSpace(payload.Name) ? fallbackDisplayName : payload.Name,
                        AvatarUrl = string.IsNullOrWhiteSpace(payload.Picture)
                            ? "https://i.pinimg.com/736x/01/6c/6f/016c6fd3571087621dc810ecfad542a9.jpg"
                            : payload.Picture,
                        Bio = "",
                        CreatedAt = DateTime.UtcNow
                    };

                    _db.UserProfiles.Add(profile);
                    user.Profile = profile;
                }

                await _db.SaveChangesAsync();
            }

            var tokenString = GenerateJwtToken(user);

            return Ok(new
            {
                token = tokenString,
                autoRegistered,
                user = new
                {
                    id = user.Id,
                    email = user.Email,
                    displayName = user.Profile?.DisplayName ?? "User",
                    avatarUrl = user.Profile?.AvatarUrl ?? "https://i.imgur.com/6VBx3io.png"
                }
            });
        }

        // GET: api/auth/verify-email?userId=1&token=...
        [HttpGet("verify-email")]
        public async Task<IActionResult> VerifyEmail([FromQuery] int userId, [FromQuery] string token)
        {
            var user = await _db.Users.FirstOrDefaultAsync(u => u.Id == userId);
            Console.WriteLine($"VERIFY CALLED userId={userId}");
            if (user == null) return BadRequest(new { message = "User không tồn tại" });

            if (user.IsEmailVerified) return Ok(new { message = "Email đã được xác thực trước đó", server = Environment.MachineName, time = DateTime.UtcNow });

            if (user.EmailVerificationExpiresAt == null || user.EmailVerificationExpiresAt < DateTime.UtcNow)
                return BadRequest(new { message = "Token đã hết hạn", code = "TOKEN_EXPIRED" });

            var tokenHash = Sha256Base64Url(token);
            if (user.EmailVerificationTokenHash == null || user.EmailVerificationTokenHash != tokenHash)
                return BadRequest(new { message = "Token không hợp lệ", code = "INVALID_TOKEN" });

            user.IsEmailVerified = true;
            user.EmailVerificationTokenHash = null;
            user.EmailVerificationExpiresAt = null;
            await _db.SaveChangesAsync();

            return Ok(new { message = "Xác thực email thành công" });
        }

        // POST: api/auth/resend-verification
        [HttpPost("resend-verification")]
        public async Task<IActionResult> ResendVerification([FromBody] ResendVerificationDto dto)
        {
